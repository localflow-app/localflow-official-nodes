{
  "node_type": "rich_text",
  "name": "Rich Text",
  "description": "Render rich text as a standard HTML file in the workflow.",
  "category": "文件与内容",
  "version": "1.0.0",
  "entry_file": "node.py",
  "dependencies": [],
  "config_schema": {
    "content": {"type": "richtext", "label": "富文本内容", "default": ""},
    "source_path": {"type": "string", "label": "源 HTML 路径（可选）", "semantic_type": "file_path", "extensions": [".html", ".htm"], "default": ""},
    "output_path": {"type": "string", "label": "输出路径", "semantic_type": "file_path", "extensions": [".html"], "default": "artifacts/rich_text.html"},
    "output_var": {"type": "string", "label": "输出变量", "default": "path"}
  },
  "input_schema": {},
  "output_schema": {
    "path": {"type": "string", "semantic_type": "file_path", "extensions": [".html"], "from_config": "output_var"}
  }
}
